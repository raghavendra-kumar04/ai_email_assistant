# Server Configuration
PORT=3000
NODE_ENV=development

# Google OAuth 2.0 & Gmail API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Set GMAIL_REFRESH_TOKEN after completing the one-time /auth/google flow
GMAIL_REFRESH_TOKEN=

# AI Providers (Gemini + Groq for ultra-fast intent parsing & query routing)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_personal_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_string

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/ai_email_assistant?retryWrites=true&w=majority

# External Cron Scheduler Secret Header (X-Job-Secret)
JOB_SECRET=your_random_32_char_job_secret_key
